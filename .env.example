# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq AI API key
GROQ_API_KEY=
# Set this to an available Groq vision model if the default is unavailable.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Sarvam AI API key (get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Deepgram API key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Google Cloud credentials (used when STT_PROVIDER = "google")
# Option 1 – path to a service-account JSON file (download from GCP Console → IAM → Service Accounts)
# Option 2 – leave blank and run: gcloud auth application-default login
# Make sure the "Cloud Speech-to-Text API" is enabled in your GCP project.
GOOGLE_APPLICATION_CREDENTIALS=

# First-party authentication (SQLite database is created automatically)
FRIDAY_AUTH_DB_PATH=.friday_data/auth.sqlite3

# Email OTP delivery (SMTP; Gmail requires an App Password, not your account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Supabase Google OAuth (use the project's publishable/anon key, never the service-role key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_API_KEY=your-supabase-publishable-or-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

GOOGLE_API_KEY=you-google-api-key (from https://aistudio.google.com/projects)

# Optional Action & Booking Engine (Default disabled)
# ENABLE_BOOKING=true
# ENABLE_TRAIN_BOOKING=true
# ENABLE_FLIGHT_BOOKING=true
# ENABLE_MOVIE_BOOKING=true
# ENABLE_HOTEL_BOOKING=true
# ENABLE_REAL_PAYMENT=false
# ENABLE_REAL_BOOKING=false